{
  "framework": null,
  "buildCommand": "npm run build",
  "crons": [
    { "path": "/api/cron/monitor", "schedule": "0 0 * * *" },
    { "path": "/api/cron/notifications", "schedule": "5 0 * * *" },
    { "path": "/api/cron/analytics", "schedule": "10 0 * * *" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "out/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?__path=/$1" }]
}
