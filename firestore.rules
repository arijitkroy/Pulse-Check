rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{uid}/{document=**} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /monitors/{id} { allow read, write: if false; }
    match /incidents/{id} { allow read, write: if false; }
    match /statusPages/{slug} { allow read, write: if false; }
    match /publicStatusPages/{slug} {
      allow read: if resource.data.isPublished == true;
      allow write: if false;
    }
    match /statusPageMetadata/{slug} { allow read, write: if false; }
    match /notificationChannelSecrets/{secretId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
